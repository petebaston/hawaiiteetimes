<!-- NEW DESIGN SYSTEM PRODUCT PAGE - Dynamic Pricing Golf Course -->

<style>
  #course > div > span {
    display: none; 
  }
  @media screen and (max-width: 767px) {
    .product_single {
      margin-left: -20px;
      margin-right: -20px;
      width: calc(100% + 40px);
    }
  }
</style>

<!-- sh_sub-added -->
{% render 'sh_sub-product-snippet' %}
<!-- /sh_sub-added -->

<section class="new-section new-product-dynamic-prices">
  <div class="new-container">
    
    <!-- Product Header -->
    <div class="new-product-header new-mb-8">
      <h1 class="new-h1 new-product-title" itemprop="name">{{ product.title }}</h1>
      
      <!-- Breadcrumb -->
      <nav class="new-breadcrumb new-mb-6" aria-label="Breadcrumb">
        <div class="new-flex new-items-center new-gap-2 new-text-sm new-text-gray-600">
          <a href="/" class="new-link-hover">Home</a>
          <span>/</span>
          {% for collection in product.collections limit:1 %}
            <a href="{{ collection.url }}" class="new-link-hover">{{ collection.title }}</a>
            <span>/</span>
          {% endfor %}
          <span class="new-text-gray-900">{{ product.title }}</span>
        </div>
      </nav>
    </div>

    <div class="new-product-content">
      <div itemscope itemtype="http://data-vocabulary.org/Product" id="product-{{ product.id }}">
        
        <!-- Product Images Slider -->
        <div class="new-product-images new-mb-8">
          {% include 'sp-slider' %}
        </div>

        <!-- Golf Course Details Grid -->
        <div class="new-grid new-grid-cols-1 new-lg:grid-cols-3 new-gap-8 new-mb-12">
          
          <!-- Main Content Column -->
          <div class="new-lg:col-span-2">
            
            <!-- Dynamic Prices Section -->
            <section class="new-dynamic-prices-section new-mb-8">
              <div class="new-card new-p-6">
                <h2 class="new-h2 new-mb-6">Dynamic Golf Rates</h2>
                {% render 'dynamic-prices' with product %}
              </div>
            </section>

            <!-- Available Tee Times Section -->
            <section class="new-teetimes-section new-mb-8 available-tee-times loading" style="display:none">
              <div class="new-card new-p-6">
                <h2 class="new-h2 new-mb-4">
                  <a name="teetimes"></a>
                  <strong>Available Tee Times</strong>
                </h2>
                <div class="additional-metafield new-mb-6">
                  {{ product.metafields.sh_sbve.additional_text_metafield }}
                </div>
                
                <!-- Tee Time Search Form -->
                <form id="avail-tee-times" class="new-tee-time-search new-mb-6">
                  <div class="new-search-teetimes new-grid new-grid-cols-1 new-md:grid-cols-3 new-gap-4">
                    <div>
                      <label class="new-label">Date of Play</label>
                      <input type="text" class="datepicker sp-datepicker new-input" name="date" readonly="readonly">
                    </div>
                    <div>
                      <label class="new-label">Tee Time</label>
                      <div id="htt-times"></div>
                    </div>
                    <div>
                      <label class="new-label"># Players</label>
                      <div id="htt-players">
                        <select id="tee-players" name="tee-players" class="new-select">
                          <option value="all">All</option>
                          <option value="1">1 Player</option>
                          <option value="2">2 Players</option>
                          <option value="3">3 Players</option>
                          <option value="4">4 Players</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </form>

                <!-- Search Results -->
                <div class="search-results">
                  <img class="spinner" src="{{ 'spinner.svg' | asset_url }}" alt="loading" width="32" height="32">
                  <div class="result-window">
                    <ul id="available-teetimes"></ul>
                    <button data-class="load-more" class="new-btn new-btn-outline">Load More Times</button>
                    <div id="response-none">
                      <div class="new-alert new-alert-warning new-text-center">
                        <h4 class="new-h4 new-text-red-600 new-font-bold">
                          There are currently no tee times available, please select another date.
                        </h4>
                        {% assign reservation_url = product.metafields.shoppad.request_reservation_url %}
                        {% assign button_text = product.metafields.shoppad.request_reservation_text %}
                        {% if reservation_url %}
                          <a href="{{ reservation_url }}" class="new-btn new-btn-primary new-mt-4">
                            {% if button_text != blank %}
                              {{ button_text }}
                            {% else %}
                              Request Priority Reservation
                            {% endif %}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- Standard Booking Section -->
            <section class="new-booking-section new-mb-8 dynamic-prices">
              <div class="new-card new-p-6">
                <h2 class="new-h2 new-mb-6">Standard Booking</h2>

                {% if product.variants.size <= 1 %}
                  {% assign variant = product.selected_or_first_available_variant %}
                  <div class="new-pricing new-mb-6" itemprop="offerDetails" itemscope itemtype="http://data-vocabulary.org/Offer">
                     <meta itemprop="currency" content="{{ shop.currency }}" />
                     <meta itemprop="seller" content="{{ shop.name | escape }}" />
                     <meta itemprop="availability" content="{% if product.available %}in_stock{% else %}out_of_stock{% endif %}" />

                     {% if variant.available == false %}
                       <div class="new-alert new-alert-warning">
                         <strong>{{ 'products.product.sold_out' | t }}</strong>
                       </div>
                     {% endif %}
                     
                     {% if variant.available %}
                       <div class="new-price-display">
                         <div class="new-price-main">
                           <span class="new-price-label">{{ variant.title }}</span>
                           <span itemprop="price" content="{{ variant.price | money_without_currency }}" class="new-price-current {% if variant.compare_at_price > variant.price %}new-price-sale{% endif %}">
                             {{ variant.price | money }}
                           </span>
                         </div>
                         {% if variant.price < variant.compare_at_price %}
                           <div class="new-price-compare">
                             <span class="new-price-was">{{ variant.compare_at_price | money }}</span>
                             <span class="new-price-savings">Save {{ variant.compare_at_price | minus: variant.price | money }}</span>
                           </div>
                         {% endif %}
                       </div>
                     {% endif %}
                  </div>
                {% endif %}
           
                <!-- Booking Form -->
                {% include 'product-notify-me' %}
                <div id="sub-bs-container" style="display:none"></div>
              </div>
            </section>

            <!-- Course Description -->
            {% if product.description != blank %}
              <section class="new-description-section new-mb-8">
                <div class="new-card new-p-6">
                  <h2 class="new-h2 new-mb-4">About {{ product.title }}</h2>
                  <div class="new-prose new-prose-lg" itemprop="description">
                    {{ product.description | split: '<!-- split -->' | first }}
                  </div>
                </div>
              </section>
            {% endif %}

            <!-- Weather Widget -->
            <section class="new-weather-section new-mb-8">
              <div class="new-card new-p-6">
                <h2 class="new-h2 new-mb-4">Local Weather Forecast</h2>
                {% include 'weather-widget' %}
              </div>
            </section>

          </div>

          <!-- Sidebar Column -->
          <div class="new-product-sidebar">
            
            <!-- Course Info Card -->
            <div class="new-card new-p-6 new-mb-6">
              <h3 class="new-h3 new-mb-4">Course Information</h3>
              
              <div class="new-course-meta new-space-y-3">
                {% if settings.display_collections %}
                  <div class="new-meta-item">
                    <span class="new-meta-label">Island:</span>
                    <div class="new-meta-value">
                      {% for col in product.collections limit:1 %}
                        <a href="{{ col.url }}" class="new-link new-link-primary">{{ col.title }}</a>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}

                {% if settings.display_type %}
                  <div class="new-meta-item">
                    <span class="new-meta-label">Course Type:</span>
                    <div class="new-meta-value" itemprop="category">{{ product.type | link_to_type }}</div>
                  </div>
                {% endif %}

                {% if settings.display_vendor %}
                  <div class="new-meta-item">
                    <span class="new-meta-label">Resort:</span>
                    <div class="new-meta-value" itemprop="brand">{{ product.vendor | link_to_vendor }}</div>
                  </div>
                {% endif %}

                {% if settings.display_tags %}
                  <div class="new-meta-item">
                    <span class="new-meta-label">Features:</span>
                    <div class="new-meta-value">
                      <div class="new-flex new-flex-wrap new-gap-1">
                        {% for tag in product.tags %}
                          {% unless tag contains 'meta-related-collection-' %}
                            <a href="/collections/{% if collection %}{{ collection.handle }}{% else %}all{% endif %}/{{ tag | handle }}" 
                               class="new-tag new-tag-sm" title="{{ 'products.product.products_tagged' | t: tag: tag }}">
                              {{ tag }}
                            </a>
                          {% endunless %}
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>

            <!-- Contact Card -->
            <div class="new-card new-p-6 new-mb-6 new-text-center">
              <h3 class="new-h3 new-mb-4">Need Help?</h3>
              <p class="new-body new-mb-4">Call our golf specialists for personalized recommendations and group bookings.</p>
              <a href="tel:1.877.465.3170" class="new-btn new-btn-primary new-btn-full">
                📞 Call (877) 465-3170
              </a>
              <p class="new-text-sm new-text-gray-600 new-mt-2">
                Located in Honolulu<br>
                No booking fees ever!
              </p>
            </div>

          </div>
        </div>

      </div>
    </div>

    <div id="sub-bs-container" style="display:none"></div>

    <!-- Related Courses -->
    {% if settings.display_related_products %}
      {% capture limit %}{{ settings.products_per_row | plus: 1 }}{% endcapture %}

      {% assign found_a_collection = false %}
      {% for c in product.collections %}
        {% if found_a_collection == false
          and c.handle != 'frontpage'
          and c.handle != 'all'
          and c.all_products_count > 1
        %}
          {% assign found_a_collection = true %}
          {% assign col = c.handle %}
        {% endif %}
      {% endfor %}

      {% for tag in product.tags %}
        {% if tag contains 'meta-related-collection-' %}
          {% assign col = tag | remove: 'meta-related-collection-' %}
          {% assign collection = collections[col] %}
          {% capture limit %}{{ collection.products_count | plus: 1 }}{% endcapture %}
        {% endif %}
      {% endfor %}

      <!-- Cross-promote other courses in same island -->
      {% unless col %}
        {% for collection in product.collections %}
          {% if collection.handle contains '-golf-courses' %}
            {% assign col = collection.handle %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endunless %}

      {% if col and collections[col].all_products_count > 1 %}
        <section class="new-related-section new-pt-12 new-border-t">
          <div class="new-section-header new-text-center new-mb-8">
            <h2 class="new-h2">Other Great Courses on This Island</h2>
            <p class="new-section-subtitle">Discover more amazing golf experiences</p>
          </div>

          <div class="new-grid new-grid-cols-1 new-sm:grid-cols-2 new-lg:grid-cols-3 new-gap-6">
            {% assign products = collections[col].products %}
            {% assign products_per_row = 3 %}
            {% for product in products limit: limit %}
              {% unless product.id == product.id %}
                {% include 'product-grid-item' %}
              {% endunless %}
            {% endfor %}
          </div>

          <div class="new-text-center new-mt-8">
            <a href="{{ collections[col].url }}" class="new-btn new-btn-outline new-btn-lg">
              View All {{ collections[col].title }}
            </a>
          </div>
        </section>
      {% endif %}
    {% endif %}

  </div>
</section>

<!-- EZLinks Dynamic Pricing Modal -->
<div class="modal-mask" id="modal-teetime">
  <div class="modal-container modal-ezlinks">
    <a href="javascript:void(0)" class="close"></a>
    <h1 class="product_name" itemprop="name">{{ product.title }}</h1>
    <ul>
      {% assign number_holes = product.metafields.ezlinks.number_holes %}
      {% if number_holes %}
        <li>{{ number_holes }} Hole Course</li>
      {% endif %}
      {% assign cart_included = product.metafields.ezlinks.cart_included %}
      {% if cart_included %}
        <li>Cart Included</li>
      {% endif %}
    </ul>
    <p data-class="datetime"></p>
    <form id="user_info">
      <input type="hidden" name="variant">
      <input type="hidden" name="date">
      <input type="hidden" name="time">
      <input type="hidden" name="players">
      <input type="hidden" name="rate_id">
      <strong>
        <div class="row" data-class="notes" style="display:none;"></div>
      </strong>
      <div class="row player-cost">
        <span># Players</span>
        <span data-class="players"></span>
        <strong data-class="price"></strong>
        <span>per player</span>
      </div>
      <div class="row">
        <div class="column four">
          <label>Full Name</label>
          <input type="text" name="full_name" placeholder="Joe Doe">
        </div>
      </div>
      <div class="row">
        <div class="column four">
          <label>Hotel (Optional)</label>
          <input type="text" name="hotel" placeholder="Hotel Name">
        </div>
      </div>
      <div class="form-actions">
        <a href="javascript:void(0)" class="button close">Cancel</a>
        <button type="submit">Add to Cart</button>
      </div>
    </form>
  </div>
</div>