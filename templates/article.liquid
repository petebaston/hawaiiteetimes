<!-- NEW DESIGN SYSTEM ARTICLE PAGE - Mobile-First Golf Article -->

{% paginate article.comments by 100 %}

<section class="new-section new-article-page">
  <div class="new-container">
    
    <!-- Breadcrumb & Navigation -->
    <div class="new-breadcrumb-nav new-mb-8">
      <nav class="new-breadcrumb new-mb-4" aria-label="Breadcrumb">
        <div class="new-flex new-items-center new-gap-2 new-text-sm new-text-gray-600">
          <a href="{{ blog.url }}" class="new-link-hover">← {{ blog.title }}</a>
        </div>
      </nav>
      
      <div class="new-article-nav new-flex new-justify-between new-items-center new-text-sm">
        <div class="new-prev-article">
          {% if blog.previous_article %}
            <a href="{{ blog.previous_article }}" class="new-btn new-btn-ghost new-btn-sm">
              ← {{ 'blogs.article.previous_article_html' | t }}
            </a>
          {% endif %}
        </div>
        <div class="new-next-article">
          {% if blog.next_article %}
            <a href="{{ blog.next_article }}" class="new-btn new-btn-ghost new-btn-sm">
              {{ 'blogs.article.next_article_html' | t }} →
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Article Layout -->
    <div class="new-grid new-grid-cols-1 new-lg:grid-cols-4 new-gap-8">
      
      <!-- Main Article Content -->
      <article class="new-article-content new-lg:col-span-3">
        <header class="new-article-header new-mb-8">
          <h1 class="new-h1 new-mb-4">{{ article.title }}</h1>
          
          <!-- Mobile Meta -->
          <div class="new-article-meta-mobile new-lg:hidden new-mb-6">
            <div class="new-flex new-flex-wrap new-gap-4 new-text-sm new-text-gray-600">
              <time>{{ article.published_at | date: format: "month_day_year" }}</time>
              {% if article.comments_enabled? %}
                <a href="#comments" class="new-link">
                  {{ 'blogs.counts.comments_with_count' | t: count: article.comments_count }}
                </a>
              {% endif %}
            </div>
            
            {% if settings.blog_tags and article.tags.size > 0 %}
              <div class="new-article-tags new-mt-3">
                <div class="new-flex new-flex-wrap new-gap-1">
                  {% for tag in article.tags %}
                    <a href="{{ shop.url}}/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" 
                       class="new-tag new-tag-sm"
                       title="{{ blog.title }} {{ 'blogs.general.tagged' | t }} {{ tag | escape }}">
                      {{ tag }}
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </div>
        </header>

        <!-- Article Body -->
        <div class="new-article-body new-prose new-prose-lg new-mb-12">
          {{ article.content }}
        </div>

        <!-- Author Info -->
        {% if settings.blog_author %}
          <div class="new-author-info new-card new-p-6 new-mb-8">
            <div class="new-flex new-gap-4">
              <div class="new-author-content">
                <h3 class="new-h3 new-mb-2">{{ article.author }}</h3>
                <p class="new-text-sm new-text-gray-600 new-mb-3">{{ 'blogs.article.author' | t }}</p>
                {% if article.user.bio %}
                  <p class="new-body">{{ article.user.bio }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}

        <!-- Comments Section -->
        <div id="comments" class="new-comments-section">
          {% if settings.disqus_enabled %}
            <div class="new-card new-p-6">
              <div id="disqus_thread"></div>
              <script type="text/javascript">
                  var disqus_shortname = '{{ settings.disqus_shortname }}';
                  (function() {
                      var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
                      dsq.src = 'http://' + disqus_shortname + '.disqus.com/embed.js';
                      (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
                  })();
              </script>
              <noscript>Please enable JavaScript to view the <a href="http://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
            </div>
          {% endif %}
          
          {% if blog.comments_enabled? %}
            {% if article.comments.size > 0 %}
              <div class="new-existing-comments new-mb-8">
                <h3 class="new-h3 new-mb-6">{{ 'blogs.comments.response_count' | t: count: article.comments.size }}</h3>
                
                <div class="new-comments-list new-space-y-6">
                  {% for comment in article.comments %}
                    <div id="comment-{{ comment.id }}" class="new-comment new-card new-p-6">
                      <div class="new-comment-header new-mb-4">
                        <h4 class="new-h4 new-mb-1">{{ comment.author }}</h4>
                        <time class="new-text-sm new-text-gray-600">
                          {{ comment.created_at | date: format: "month_day_year" }}
                        </time>
                      </div>
                      <div class="new-comment-content new-prose">
                        {{ comment.content }}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
            
            {% if comment and comment.created_at %}
              {% if article.comments_count == 0 %}
                <h3 class="new-h3 new-mb-6">{{ 'blogs.comments.response_count' | t: count: article.comments.size }}</h3>
              {% endif %}
              <div id="comment-{{ comment.id }}" class="new-comment new-card new-p-6 new-mb-8">
                <div class="new-comment-header new-mb-4">
                  <h4 class="new-h4 new-mb-1">{{ comment.author }}</h4>
                  <time class="new-text-sm new-text-gray-600">
                    {{ comment.created_at | date: format: "month_day_year" }}
                  </time>
                </div>
                <div class="new-comment-content new-prose">
                  {{ comment.content }}
                </div>
              </div>
            {% endif %}
            
            {% include 'pagination' %}
            
            <!-- Comment Form -->
            <div id="new-comment" class="new-comment-form">
              <div class="new-card new-p-6">
                <h3 class="new-h3 new-mb-6">{{ 'blogs.comments.title' | t }}</h3>
              
                {% form article %}
                  {% if form.posted_successfully? %}
                    <div class="new-alert new-alert-success new-mb-6">
                      {% if blog.moderated? %}
                        {{ 'blogs.comments.success_moderated' | t }}
                      {% else %}
                        {{ 'blogs.comments.success' | t }}
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if form.errors %}
                    <div class="new-alert new-alert-error new-mb-6">
                      {{ 'general.forms.post_error' | t }}
                    </div>
                  {% endif %}

                  <div class="new-form-grid new-grid new-grid-cols-1 new-sm:grid-cols-2 new-gap-4 new-mb-6">
                    <div class="new-form-field">
                      <label for="comment_author" class="new-form-label">
                        {{ 'blogs.comments.name' | t }} <span class="new-text-red-500">*</span>
                      </label>
                      <input type="text" id="comment_author" name="comment[author]" 
                             value="{{ form.author }}" required="required" 
                             class="new-form-input" />
                    </div>

                    <div class="new-form-field">
                      <label for="comment_email" class="new-form-label">
                        {{ 'blogs.comments.email' | t }} <span class="new-text-red-500">*</span>
                      </label>
                      <input type="email" id="comment_email" name="comment[email]" 
                             value="{{ form.email }}" required="required" 
                             class="new-form-input" />
                    </div>
                  </div>

                  <div class="new-form-field new-mb-6">
                    <label for="comment_body" class="new-form-label">
                      {{ 'blogs.comments.comment' | t }} <span class="new-text-red-500">*</span>
                    </label>
                    <textarea id="comment_body" name="comment[body]" rows="5" 
                              required="required" class="new-form-textarea">{{ form.body }}</textarea>
                  </div>

                  {% if blog.moderated? %}
                    <p class="new-text-sm new-text-gray-600 new-mb-6">
                      <em>{{ 'blogs.comments.moderated' | t }}</em>
                    </p>
                  {% endif %}
                
                  <button type="submit" id="comment-submit" class="new-btn new-btn-primary">
                    {{ 'blogs.comments.post' | t }}
                  </button>
                {% endform %}
              </div>
            </div>
          {% endif %}
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="new-article-sidebar new-lg:col-span-1">
        <div class="new-sidebar-content new-space-y-6">
          
          <!-- Desktop Meta -->
          <div class="new-article-meta-desktop new-hidden new-lg:block">
            <div class="new-card new-p-6">
              <h3 class="new-h3 new-mb-4">Article Details</h3>
              
              <div class="new-meta-items new-space-y-3">
                <div class="new-meta-item">
                  <span class="new-meta-label">Published</span>
                  <time class="new-meta-value">{{ article.published_at | date: format: "month_day_year" }}</time>
                </div>

                {% if article.comments_enabled? %}
                  <div class="new-meta-item">
                    <span class="new-meta-label">Comments</span>
                    <a href="#comments" class="new-link new-meta-value">
                      {{ 'blogs.counts.comments_with_count' | t: count: article.comments_count }}
                    </a>
                  </div>
                {% endif %}

                {% if settings.blog_tags and article.tags.size > 0 %}
                  <div class="new-meta-item">
                    <span class="new-meta-label">Topics</span>
                    <div class="new-meta-value">
                      <div class="new-flex new-flex-wrap new-gap-1 new-mt-2">
                        {% for tag in article.tags %}
                          <a href="{{ shop.url}}/blogs/{{ blog.handle }}/tagged/{{ tag | handleize }}" 
                             class="new-tag new-tag-sm"
                             title="{{ blog.title }} {{ 'blogs.general.tagged' | t }} {{ tag | escape }}">
                            {{ tag }}
                          </a>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Social Share -->
          <div class="new-social-share-sidebar">
            <div class="new-card new-p-6">
              <h3 class="new-h3 new-mb-4">Share Article</h3>
              {% include "social-buttons" with "article" %}
            </div>
          </div>

          <!-- Recent Articles -->
          {% if settings.display_recent_articles %}
            <div class="new-recent-articles">
              <div class="new-card new-p-6">
                <h3 class="new-h3 new-mb-4">{{ 'blogs.sidebar.recent_articles' | t }}</h3>
                <div class="new-space-y-3">
                  {% for article in blog.articles limit:5 %}
                    <div class="new-recent-article">
                      <a href="{{ article.url }}" class="new-link" title="{{ article.title | escape }}">
                        {{ article.title }}
                      </a>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

          <!-- Blog Content Page -->
          {% if settings.blog_content_page != blank %}
            <div class="new-blog-sidebar-content">
              <div class="new-card new-p-6 new-prose">
                {{ pages[settings.blog_content_page].content }}
              </div>
            </div>
          {% endif %}

          <!-- Blog Search -->
          <div class="new-blog-search">
            <div class="new-card new-p-6">
              <h3 class="new-h3 new-mb-4">Search {{ blog.title }}</h3>
              <form action="/search" class="new-search-form">
                <input type="hidden" name="type" value="article" />
                <div class="new-flex new-gap-2">
                  <input type="text" name="q" 
                         placeholder="Search articles..." 
                         value="{{ search.terms }}" 
                         class="new-form-input new-flex-1"
                         autocapitalize="off" 
                         autocomplete="off" 
                         autocorrect="off" />
                  <button type="submit" class="new-btn new-btn-primary">
                    Search
                  </button>
                </div>
              </form>
            </div>
          </div>

        </div>
      </aside>
    </div>

  </div>
</section>

<script type="text/javascript">
  // <![CDATA[  
    $(function() {    
      if(window.location.pathname.indexOf('/comments') != -1) {
        $('html,body').animate({scrollTop: $("#new-comment").offset().top-110},'slow');
      }
    });
  // ]]>
</script>

{% endpaginate %}    