<!-- NEW DESIGN SYSTEM CART PAGE - Mobile-First Golf Booking Cart (without sh_sub) -->

{% assign has_price_property = false %}
{% for item in cart.items %}
  {% if item.properties._price %}
    {% assign has_price_property = true %}
    {% break %}
  {% endif %}
{% endfor %}

<section class="new-section new-cart-page">
  <div class="new-container">
    
    <!-- Page Header -->
    <div class="new-cart-header new-mb-8">
      <h1 class="new-h1">{{ 'cart.general.title' | t }}</h1>
      <p class="new-section-subtitle">Review your golf course bookings before checkout</p>
    </div>

    {% if cart.item_count == 0 %}
      <!-- Empty Cart State -->
      <div class="new-empty-cart new-text-center new-py-16">
        <div class="new-card new-p-8 new-max-w-md new-mx-auto">
          <div class="new-empty-cart-icon new-mb-6">
            🏌️‍♂️
          </div>
          <h2 class="new-h2 new-mb-4">Your Cart is Empty</h2>
          <p class="new-body new-mb-6 new-text-gray-600">{{ 'cart.general.continue_browsing_html' | t }}</p>
          <a href="/" class="new-btn new-btn-primary new-btn-lg">
            Browse Golf Courses
          </a>
        </div>
      </div>
    {% else %}
      <!-- Cart with Items -->
      <div class="new-cart-content">
        {% include "sms_notifier" %}
        
        <form action="/cart" method="post" id="cart_form" class="new-cart-form">
          
          <!-- Mobile Cart Items -->
          <div class="new-cart-items new-mb-8">
            {% for item in cart.items %}
              <div class="new-cart-item">
                <div class="new-card new-p-6 new-mb-4">
                  
                  <!-- Mobile Layout -->
                  <div class="new-block new-md:hidden">
                    <div class="new-flex new-gap-4 new-mb-4">
                      <!-- Course Image -->
                      <div class="new-cart-item-image new-flex-shrink-0">
                        <a href="{{ item.url }}" title="{{ item.title | escape }}">
                          <img src="{{ item | img_url: 'compact' }}" alt="{{ item.title | escape }}" class="new-img-responsive new-rounded-lg" style="width: 80px; height: 60px; object-fit: cover;" />
                        </a>
                      </div>
                      
                      <!-- Course Info -->
                      <div class="new-flex-1">
                        <h3 class="new-h3 new-mb-2">
                          <a href="{{ item.product.url }}" class="new-link-primary">{{ item.title }}</a>
                        </h3>
                        <p class="new-price-current new-text-lg new-font-bold">
                          {% if item.properties._price %}
                            {{ item.properties._price | times: 100 | money }}
                          {% else %}
                            {{ item.price | money }}
                          {% endif %}
                        </p>
                      </div>
                      
                      <!-- Remove Button -->
                      <div class="new-flex-shrink-0">
                        <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" 
                           title="{{ 'cart.general.remove' | t }}" 
                           class="new-btn new-btn-ghost new-btn-sm">
                          Remove
                        </a>
                      </div>
                    </div>
                    
                    <!-- Booking Details -->
                    <div class="new-booking-details new-mb-4">
                      {% assign from_ezlinks = false %}
                      {% for p in item.properties %}
                        {% assign first_character_in_key = p.first | truncate: 1, '' %}
                        {% if p.first == '_courseid' and p.last %}
                          {% assign from_ezlinks = true %}
                        {% endif %}
                        {% unless p.last == blank or first_character_in_key == '_' %}
                          {% unless p.first contains 'product' %}
                            <div class="new-booking-detail">
                              <span class="new-detail-label">
                                {{ p.first | replace: 'booking-', '' | replace: 'start', 'date' | replace: 'start-2', 'date' | replace: 'start-3', 'date' | replace: 'time', 'time' | replace: 'time-2', 'time'  | replace: 'time-3', 'time' | replace: 'party', 'players' | replace: '-', ' ' | capitalize }}:
                              </span>
                              <span class="new-detail-value">
                                {% if p.last contains '/uploads/' %}
                                  <a class="lightbox new-link" href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                                {% else %}
                                  {% if p.first contains 'time' %}
                                    {% assign hh = p.last | split: ":" | first | plus:0 %}
                                    {% if hh > 12 %}{{ hh | minus:12 }}{% else %}{{ hh }}{% endif %}:{{ p.last | split: ":" | last }}
                                  {% else %}
                                    {{ p.last }}
                                  {% endif %}
                                {% endif %}
                              </span>
                            </div>
                          {% else %}
                            {% assign parts = p.last | split: '|' %}
                            <div class="new-booking-detail">
                              <span class="new-detail-value new-font-medium">{{ parts.first }}:</span>
                            </div>
                          {% endunless %}
                        {% endunless %}
                      {% endfor %}
                      {% if settings.show_vendor %}
                        <div class="new-booking-detail">
                          <span class="new-detail-label">Resort:</span>
                          <span class="new-detail-value">{{ item.vendor }}</span>
                        </div>
                      {% endif %}
                    </div>
                    
                    <!-- Quantity and Total -->
                    <div class="new-flex new-justify-between new-items-center">
                      <div class="new-quantity-control">
                        {% if from_ezlinks %}
                          <span class="new-body">Quantity: {{ item.quantity }}</span>
                          <input type="hidden" name="updates[]" class="cart_quantity_input" id="updates_{{ item.key }}" value="{{ item.quantity }}">
                        {% else %}
                          <label class="new-form-label new-text-sm">{{ 'cart.general.quantity' | t }}:</label>
                          <input type="number" min="0" size="2" class="new-form-input new-quantity-input" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" />
                        {% endif %}
                      </div>
                      
                      <div class="new-item-total">
                        <span class="new-text-sm new-text-gray-600">Total:</span>
                        <span class="new-price-current new-text-lg new-font-bold">
                          {% if item.properties._price %}
                            {{ item.properties._price | times: 100 | times: item.quantity | money }}
                          {% else %}
                            {{ item.line_price | money }}
                          {% endif %}
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- Desktop Layout -->
                  <div class="new-hidden new-md:block">
                    <div class="new-grid new-grid-cols-12 new-gap-4 new-items-start">
                      
                      <!-- Course Image & Info -->
                      <div class="new-col-span-6">
                        <div class="new-flex new-gap-4">
                          <div class="new-cart-item-image new-flex-shrink-0">
                            <a href="{{ item.url }}" title="{{ item.title | escape }}">
                              <img src="{{ item | img_url: 'compact' }}" alt="{{ item.title | escape }}" class="new-img-responsive new-rounded-lg" style="width: 100px; height: 75px; object-fit: cover;" />
                            </a>
                          </div>
                          <div>
                            <h3 class="new-h3 new-mb-2">
                              <a href="{{ item.product.url }}" class="new-link-primary">{{ item.title }}</a>
                            </h3>
                            <!-- Booking Details for Desktop -->
                            <div class="new-booking-details new-text-sm">
                              {% assign from_ezlinks = false %}
                              {% for p in item.properties %}
                                {% assign first_character_in_key = p.first | truncate: 1, '' %}
                                {% if p.first == '_courseid' and p.last %}
                                  {% assign from_ezlinks = true %}
                                {% endif %}
                                {% unless p.last == blank or first_character_in_key == '_' %}
                                  {% unless p.first contains 'product' %}
                                    <div class="new-booking-detail">
                                      <span class="new-detail-label">
                                        {{ p.first | replace: 'booking-', '' | replace: 'start', 'Date' | replace: 'start-2', 'Date' | replace: 'start-3', 'Date' | replace: 'time', 'Time' | replace: 'time-2', 'Time'  | replace: 'time-3', 'Time' | replace: 'party', 'Players' | replace: '-', ' ' | capitalize }}:
                                      </span>
                                      <span class="new-detail-value">
                                        {% if p.first contains 'time' %}
                                          {% assign hh = p.last | split: ":" | first | plus:0 %}
                                          {% if hh > 12 %}{{ hh | minus:12 }}{% else %}{{ hh }}{% endif %}:{{ p.last | split: ":" | last }}
                                        {% else %}
                                          {{ p.last }}
                                        {% endif %}
                                      </span>
                                    </div>
                                  {% endunless %}
                                {% endunless %}
                              {% endfor %}
                            </div>
                          </div>
                        </div>
                      </div>
                      
                      <!-- Price -->
                      <div class="new-col-span-2 new-text-center">
                        <span class="new-price-current new-font-bold">
                          {% if item.properties._price %}
                            {{ item.properties._price | times: 100 | money }}
                          {% else %}
                            {{ item.price | money }}
                          {% endif %}
                        </span>
                      </div>
                      
                      <!-- Quantity -->
                      <div class="new-col-span-2 new-text-center">
                        {% if from_ezlinks %}
                          {{ item.quantity }}
                          <input type="hidden" name="updates[]" class="cart_quantity_input" id="updates_{{ item.key }}" value="{{ item.quantity }}">
                        {% else %}
                          <input type="number" min="0" size="2" class="new-form-input new-quantity-input new-text-center" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" />
                        {% endif %}
                      </div>
                      
                      <!-- Total -->
                      <div class="new-col-span-2 new-text-center">
                        <span class="new-price-current new-font-bold">
                          {% if item.properties._price %}
                            {{ item.properties._price | times: 100 | times: item.quantity | money }}
                          {% else %}
                            {{ item.line_price | money }}
                          {% endif %}
                        </span>
                        <div class="new-mt-2">
                          <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" 
                             title="{{ 'cart.general.remove' | t }}" 
                             class="new-btn new-btn-ghost new-btn-sm">
                            Remove
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Cart Summary -->
          <div class="new-grid new-grid-cols-1 new-lg:grid-cols-3 new-gap-8">
            
            <!-- Special Instructions -->
            {% if settings.display_special_instructions %}
              <div class="new-lg:col-span-2">
                <div class="new-card new-p-6">
                  <h3 class="new-h3 new-mb-4">Additional Notes or Requests</h3>
                  <p class="new-text-sm new-text-gray-600 new-mb-4">Please list cell phone number if using Apple Pay, Google Pay, or PayPal</p>
                  <textarea id="note" name="note" rows="4" class="new-form-textarea" placeholder="Any special requests or additional information...">{{ cart.note }}</textarea>
                </div>
              </div>
            {% endif %}

            <!-- Order Summary -->
            <div class="{% if settings.display_special_instructions %}new-lg:col-span-1{% else %}new-lg:col-span-3 new-max-w-md new-lg:ml-auto{% endif %}">
              <div class="new-card new-p-6">
                <h3 class="new-h3 new-mb-6">Order Summary</h3>
                
                <!-- Subtotal Calculation -->
                {% assign subtotal = 0 %}
                {% for item in cart.items %}
                  {% if item.properties._price %}
                    {% assign item_price = item.properties._price | times: 100 %}
                  {% else %}
                    {% assign item_price = item.price %}
                  {% endif %}
                  {% assign item_total = item_price | times: item.quantity %}
                  {% assign subtotal = subtotal | plus: item_total %}
                {% endfor %}
                
                <div class="new-order-total new-mb-6">
                  <div class="new-flex new-justify-between new-items-center new-py-4 new-border-b">
                    <span class="new-text-lg">{{ 'cart.general.subtotal' | t }}</span>
                    <span class="new-text-lg new-font-bold">{{ subtotal | money_with_currency }}</span>
                  </div>
                  {% if settings.show_multiple_currencies %}
                    <p class="new-text-sm new-text-gray-600 new-mt-2">
                      <em>{{ 'cart.general.orders_processed_in_currency_html' | t: currency: shop.currency }}</em>
                    </p>
                  {% endif %}
                </div>

                <!-- Terms Agreement -->
                <div class="new-terms-agreement new-mb-6">
                  <label class="new-flex new-items-start new-gap-3 new-cursor-pointer">
                    <input type="checkbox" name="agree-terms" id="agree-terms" class="new-checkbox new-mt-1" />
                    <span class="new-text-sm">
                      I agree with the <a href="/pages/terms-conditions" class="new-link new-link-primary">Terms and Conditions</a>
                    </span>
                  </label>
                </div>

                <!-- Checkout Actions -->
                <div class="new-checkout-actions">
                  <div class="new-flex new-gap-4 new-mb-4">
                    <button type="button" class="new-btn new-btn-outline new-flex-1 update_subtotal">
                      {{ 'cart.general.update' | t }}
                    </button>
                    <input type="submit" class="new-btn new-btn-primary new-flex-1" id="checkout" name="checkout" value="{{ 'cart.general.checkout' | t }}" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Continue Shopping -->
          <div class="new-continue-shopping new-text-center new-mt-8">
            {% if cart.item_count != 0 %}
              {% assign the_island_url = '' %}
              {% for island in cart.items.first.product.collections %}
                {% if island.handle == 'oahu-golf-courses' or island.handle == 'maui-golf-courses' or island.handle == 'kauai-golf-courses' or island.handle == 'big-island-golf-courses' or island.handle == 'lanai-golf-courses' %}
                  {% assign the_island_url = island.url %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% if the_island_url == '' %}
                {% assign the_island_url = '/' %}
              {% endif %}
              <a href="{{ the_island_url }}" class="new-btn new-btn-outline">
                ← Continue Shopping
              </a>
            {% endif %}
          </div>

        </form>
      </div>
    {% endif %}

  </div>
</section>

{% include 'cart-shipping-calculator' %}

<script type="text/javascript">
$(".submit-cart input[type='submit'],.submit-cart input[type='image'], .new-checkout-actions input[type='submit']").click(function(){
    if ($('#agree-terms').is(':checked')) {
        return true;
    } else{
        alert("{{ 'cart.general.terms' | t }}");
        return false;
    }
});

$(".update_subtotal").click(function(e){
    e.preventDefault();
    $("#cart_form").submit();
});
</script>

<style>
  .draft_checkout {
    background: #70bc42;
    color: #fff;
    padding: 11px 14px;
    font-weight: 700 !important;
    cursor: pointer; 
  }  
</style>