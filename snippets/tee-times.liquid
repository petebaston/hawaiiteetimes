    function trackConversion() {
       console.log('running track conversion')
    // Extract query parameters from the URL
    var query = location.search.substring(1);
    var params = query.split('&');
    var rwgToken = undefined;


    // Find the 'rwg_token' parameter in the query string
    for (var i = 0; i < params.length; ++i) {
        var pair = params[i].split('=');
        if (pair[0] === 'rwg_token') {
            rwgToken = decodeURIComponent(pair[1]);
            break;
        }
    }


    // Store the rwg_token in a cookie if found
    if (typeof rwgToken !== 'undefined') {
        document.cookie =
            "_rwg_token=" + rwgToken + ";max-age=2592000;path=/;domain=hawaiiteetimes.com";
    }


    // Define your partner ID
    const partnerId = 20003390;


    // Define the endpoint
    const endpoint = `https://www.google.com/maps/conversion/collect`;


    // Retrieve the stored rwg_token cookie
    const rwgTokenCookie = document.cookie
        .split('; ')
        .find(row => row.startsWith('_rwg_token='));


    if (typeof rwgTokenCookie !== 'undefined') {
        const rwgTokenVal = rwgTokenCookie.split('=')[1];


        // Send the conversion request
        fetch(endpoint, {
            method: "POST",
            headers: {
                "Content-Type": "text/plain"
            },
            body: JSON.stringify({
                conversion_partner_id: partnerId,
                rwg_token: rwgTokenVal,
                merchant_changed: "2"
            })
        }).then(response => {
            console.log("Conversion tracking response:", response);
        }).catch(error => {
            console.error("Error sending conversion tracking request:", error);
        });
    }
}
