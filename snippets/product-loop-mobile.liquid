{% comment %}
NEW DESIGN SYSTEM MOBILE PRODUCT LOOP - Single Column Golf Course Grid
Mobile-optimized version showing fewer courses (limit 3) in single column
{% endcomment %}

{% assign product_found = false %}
{% assign skip = false %}

<!-- Mobile Golf Course Grid Container -->
<div class="new-products-grid-mobile new-grid new-grid-cols-1 new-gap-4">
  {% for product in products limit:3 %}
    {% if product.id == skip_product.id or skip == true %}
      {% assign product_found = true %}
    {% else %}
      {% if forloop.rindex0 == 0 and product_found == false and forloop.length != products.count and template != 'search' %}
        {% assign skip = true %}
      {% else %}
        {% include 'product-thumbnail' %}
      {% endif %}    
    {% endif %}
  {% endfor %}
</div>

{% comment %}
Mobile version uses single column layout and smaller gap between cards
Limits display to 3 products for better mobile performance
{% endcomment %}