{% comment %}
NEW DESIGN SYSTEM PRODUCT LOOP - Mobile-First Golf Course Grid
Responsive grid that displays course cards using CSS Grid
{% endcomment %}

{% assign product_found = false %}
{% assign skip = false %}

<!-- Golf Course Grid Container -->
<div class="new-products-grid new-grid new-grid-cols-1 new-sm:grid-cols-2 new-lg:grid-cols-3 new-gap-6">
  {% for product in products limit: limit %}
    {% if product.id == skip_product.id or skip == true %}
      {% assign product_found = true %}
    {% else %}
      {% if forloop.rindex0 == 0 and product_found == false and forloop.length != products.count and template != 'search' %}
        {% assign skip = true %}
      {% else %}
        {% include 'product-thumbnail' %}
      {% endif %}    
    {% endif %}
  {% endfor %}
</div>

{% comment %}
Legacy grid clear elements are no longer needed with CSS Grid
The new grid system automatically handles responsive layout:
- Mobile: 1 column
- Small screens (640px+): 2 columns  
- Large screens (1024px+): 3 columns
{% endcomment %}