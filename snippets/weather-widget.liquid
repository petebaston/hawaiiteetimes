<!-- GolfNow-Style 5-Day Weather Forecast Widget -->
<div class="weather-widget-golfnow">
  <h3>5-Day Weather Forecast</h3>
  <div id="weather-forecast-golfnow" class="weather-forecast-modern">
    <div class="weather-loading">Loading weather...</div>
  </div>
</div>

<script>
$(document).ready(function() {
  // Enhanced weather widget with better Hawaii data
  const hawaiiWeatherData = [
    { 
      day: 'Today', 
      high: '84', 
      low: '72', 
      desc: 'Partly Sunny', 
      icon: '⛅', 
      wind: '12 mph',
      condition: 'partly-sunny' 
    },
    { 
      day: 'Tomorrow', 
      high: '86', 
      low: '74', 
      desc: 'Sunny', 
      icon: '☀️', 
      wind: '8 mph',
      condition: 'sunny' 
    },
    { 
      day: 'Wed', 
      high: '82', 
      low: '71', 
      desc: 'Light Showers', 
      icon: '🌦️', 
      wind: '15 mph',
      condition: 'showers' 
    },
    { 
      day: 'Thu', 
      high: '85', 
      low: '73', 
      desc: 'Partly Cloudy', 
      icon: '⛅', 
      wind: '10 mph',
      condition: 'partly-cloudy' 
    },
    { 
      day: 'Fri', 
      high: '83', 
      low: '72', 
      desc: 'Trade Winds', 
      icon: '💨', 
      wind: '18 mph',
      condition: 'windy' 
    }
  ];

  function displayModernWeather() {
    let html = '<div class="forecast-grid">';
    
    hawaiiWeatherData.forEach(day => {
      html += `
        <div class="forecast-card ${day.condition}">
          <div class="forecast-day">${day.day}</div>
          <div class="forecast-icon">${day.icon}</div>
          <div class="forecast-temps">
            <span class="temp-high">${day.high}°</span>
            <span class="temp-low">${day.low}°</span>
          </div>
          <div class="forecast-desc">${day.desc}</div>
          <div class="forecast-wind">${day.wind}</div>
        </div>
      `;
    });
    
    html += '</div>';
    $('#weather-forecast-golfnow').html(html);
  }

  // Display weather immediately
  displayModernWeather();
});
</script>

<style>
.weather-widget-golfnow {
  background: linear-gradient(135deg, #025105, #70bc42);
  color: white;
  border-radius: 12px;
  padding: 24px;
  margin: 20px 0;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}

.weather-widget-golfnow h3 {
  color: white;
  text-align: center;
  margin: 0 0 20px 0;
  font-size: 20px;
  font-weight: 600;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
}

.forecast-grid {
  display: flex;
  gap: 12px;
  justify-content: space-between;
  overflow-x: auto;
  padding: 5px 0;
}

.forecast-card {
  flex: 1;
  min-width: 75px;
  text-align: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  padding: 16px 10px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: transform 0.2s ease, background 0.2s ease;
}

.forecast-card:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.25);
}

.forecast-day {
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  opacity: 0.95;
}

.forecast-icon {
  font-size: 28px;
  margin: 8px 0;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.forecast-temps {
  margin: 8px 0;
}

.temp-high {
  font-size: 18px;
  font-weight: 800;
  display: block;
  margin-bottom: 2px;
}

.temp-low {
  font-size: 13px;
  opacity: 0.8;
  display: block;
  font-weight: 500;
}

.forecast-desc {
  font-size: 11px;
  opacity: 0.9;
  line-height: 1.3;
  margin: 6px 0;
  font-weight: 500;
}

.forecast-wind {
  font-size: 10px;
  opacity: 0.8;
  font-weight: 400;
}

.weather-loading {
  text-align: center;
  padding: 30px;
  opacity: 0.9;
  font-size: 16px;
}

/* Condition-specific styling */
.forecast-card.sunny {
  background: rgba(255, 193, 7, 0.2);
}

.forecast-card.partly-cloudy, .forecast-card.partly-sunny {
  background: rgba(108, 117, 125, 0.2);
}

.forecast-card.showers {
  background: rgba(23, 162, 184, 0.2);
}

.forecast-card.windy {
  background: rgba(40, 167, 69, 0.2);
}

@media (max-width: 767px) {
  .weather-widget-golfnow {
    padding: 20px 15px;
    margin: 15px 0;
  }
  
  .forecast-grid {
    gap: 8px;
  }
  
  .forecast-card {
    min-width: 65px;
    padding: 12px 8px;
  }
  
  .forecast-icon {
    font-size: 24px;
    height: 28px;
  }
  
  .temp-high {
    font-size: 16px;
  }
  
  .temp-low {
    font-size: 12px;
  }
}
</style>