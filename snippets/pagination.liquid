{% comment %}
NEW DESIGN SYSTEM PAGINATION - Mobile-First Responsive Pagination
Responsive pagination that works well on all devices
{% endcomment %}

{% if paginate.pages > 1 %}  
  <div class="new-pagination-container new-mt-12">
    <div class="new-container">    
      <div class="new-pagination new-flex new-justify-center new-items-center new-gap-2">
        {{ paginate | default_pagination }}
      </div>  
    </div>
  </div>
{% endif %}

<style>
.new-pagination-container {
  margin-top: var(--space-12);
  padding: var(--space-6) 0;
  border-top: 1px solid var(--color-gray-200);
}

.new-pagination {
  text-align: center;
}

.new-pagination a,
.new-pagination span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  min-width: 44px;
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
}

.new-pagination a {
  background: var(--color-white);
  color: var(--color-gray-700);
  border: 1px solid var(--color-gray-300);
}

.new-pagination a:hover {
  background: var(--color-primary);
  color: var(--color-white);
  border-color: var(--color-primary);
}

.new-pagination span.current {
  background: var(--color-primary);
  color: var(--color-white);
  border: 1px solid var(--color-primary);
}

.new-pagination span.deco {
  background: transparent;
  border: none;
  color: var(--color-gray-500);
}

@media (max-width: 767px) {
  .new-pagination a,
  .new-pagination span {
    min-height: 48px;
    min-width: 48px;
    font-size: var(--text-lg);
  }
  
  .new-pagination {
    gap: var(--space-1);
  }
}
</style>